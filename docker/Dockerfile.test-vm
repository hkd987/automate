FROM ubuntu:22.04
RUN apt-get update && apt-get install -y openssh-server sudo && rm -rf /var/lib/apt/lists/*
RUN mkdir /var/run/sshd
RUN useradd -m -s /bin/bash testuser && echo "testuser:testpass" | chpasswd && adduser testuser sudo
RUN mkdir -p /home/testuser/.ssh && chmod 700 /home/testuser/.ssh
RUN ssh-keygen -t ed25519 -f /home/testuser/.ssh/id_ed25519 -N "" && \
    cp /home/testuser/.ssh/id_ed25519.pub /home/testuser/.ssh/authorized_keys && \
    chmod 600 /home/testuser/.ssh/authorized_keys && \
    chown -R testuser:testuser /home/testuser/.ssh
RUN echo "testuser ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers
EXPOSE 22
CMD ["/usr/sbin/sshd", "-D"]
